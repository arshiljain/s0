{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/a24.raviklaassens.com/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/a24.raviklaassens.com/index.html"
    },
    {
